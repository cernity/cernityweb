---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { guideGroups } from '../../data/guides';
const docs = await getCollection('docs');
const bySlug = new Map(docs.map(d=>[d.slug,d]));
---
<Base title="Learn, deploy, investigate — Cernity documentation" description="A practical guide to Suricata records, Cernity architecture, sensor transport, installation, optional enrichment, and SIEM investigation.">
  <section class="hero page-hero"><span class="pill">CERNITY / THE PRACTICAL GUIDE</span><h1>Understand the signal.<br />Follow it all the way.</h1><p class="lede">From your first EVE record to a working deployment and an analyst's investigation. Learn what each component does, how the data moves, and what the evidence can actually tell you.</p></section>
  <section class="learning-path"><a href="/docs/reading-records/"><span class="eyebrow">I WANT TO UNDERSTAND</span><h2>Start with a record.</h2><p>Learn the difference between an observation, an alert, and a finding.</p><span class="text-link">Read the field guide →</span></a><a href="/docs/getting-started/"><span class="eyebrow">I WANT TO INSTALL</span><h2>Connect the pipeline.</h2><p>Work through the central host, sensor configuration, shipper, and SIEM.</p><span class="text-link">Start the installation →</span></a><a href="/proof/"><span class="eyebrow">I WANT TO EVALUATE</span><h2>Inspect the evidence.</h2><p>Compare actual records, including false leads and missing context.</p><span class="text-link">Open the case studies →</span></a></section>
  <div class="docs-groups">{guideGroups.map(group=><section class="docs-group"><div><span class="pill">{group.label}</span><h2>{group.title}</h2><p class="group-description">{group.description}</p></div><div>{group.guides.map(guide=>{const doc=bySlug.get(guide.slug);return doc&&<a class="doc-link" href={`/docs/${guide.slug}/`}><div><strong>{doc.data.nav}</strong><p>{guide.description}</p></div><span aria-hidden="true">↗</span></a>})}</div></section>)}</div>
</Base>
