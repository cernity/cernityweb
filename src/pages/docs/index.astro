---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const NDR_REPO = 'https://github.com/cernity/cernityndr';
const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Docs — Cernity NDR" description="Product documentation for Cernity NDR — deploy, configure, and integrate the behavioural detection tier.">
  <section class="hero" style="padding-bottom: 8px;">
    <h1>Documentation</h1>
    <p class="lede">
      Everything to deploy Cernity onto a Suricata sensor and wire it into your SIEM. The
      product is open source — the code lives at <a href={NDR_REPO}>cernity/cernityndr</a>.
    </p>
  </section>
  <section>
    <div class="grid">
      {docs.map((d) => (
        <a class="card" href={`/docs/${d.slug}`}>
          <h3>{d.data.nav}</h3>
          <p class="muted">{d.data.title}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
