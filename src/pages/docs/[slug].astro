---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
  return docs.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, docs },
  }));
}

const { entry, docs } = Astro.props;
const { Content } = await entry.render();
---
<Base title={`${entry.data.title} — Cernity docs`} description={entry.data.title}>
  <div class="docs-layout">
    <aside class="docs-nav">
      <div class="docs-nav-head">Documentation</div>
      <ul>
        {docs.map((d) => (
          <li>
            <a href={`/docs/${d.slug}`} class={d.slug === entry.slug ? 'active' : ''}>{d.data.nav}</a>
          </li>
        ))}
      </ul>
    </aside>
    <article class="docs-content">
      <Content />
      <p class="docs-back"><a href="/docs/">← All documentation</a></p>
    </article>
  </div>
</Base>
