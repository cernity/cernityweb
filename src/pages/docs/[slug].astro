---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { guideGroups, orderedGuides } from '../../data/guides';
export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map(entry=>({params:{slug:entry.slug},props:{entry,docs}}));
}
const {entry,docs}=Astro.props;
const {Content,headings}=await entry.render();
const bySlug = new Map(docs.map(d=>[d.slug,d]));
const position=orderedGuides.findIndex(g=>g.slug===entry.slug);
const previous=position>0?orderedGuides[position-1]:undefined;
const next=position>=0?orderedGuides[position+1]:undefined;
const guide=orderedGuides[position];
---
<Base title={`${entry.data.title} — Cernity docs`} description={guide?.description || entry.data.title}>
  <div class="docs-layout">
    <aside class="docs-nav"><nav aria-label="Documentation"><div class="docs-nav-head"><a href="/docs/">Documentation</a></div>{guideGroups.map(group=><div class="docs-nav-group"><div class="docs-group-label">{group.label}</div><ul>{group.guides.map(g=>{const d=bySlug.get(g.slug);return d&&<li><a href={`/docs/${d.slug}/`} class={d.slug===entry.slug?'active':''} aria-current={d.slug===entry.slug?'page':undefined}>{d.data.nav}</a></li>})}</ul></div>)}</nav></aside>
    <article class="docs-content"><div class="breadcrumbs"><a href="/docs/">DOCS</a> / {entry.data.nav.toUpperCase()}</div><Content /><nav class="guide-pagination" aria-label="Guide navigation">{previous&&<a href={`/docs/${previous.slug}/`}><span>← PREVIOUS</span><strong>{bySlug.get(previous.slug)?.data.nav}</strong></a>}{next&&<a href={`/docs/${next.slug}/`}><span>NEXT →</span><strong>{bySlug.get(next.slug)?.data.nav}</strong></a>}</nav><p class="docs-back"><a href="/docs/">← All documentation</a></p></article>
    <aside class="docs-toc"><nav aria-label="On this page"><div class="docs-nav-head">On this page</div><ul>{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav></aside>
  </div>
</Base>
