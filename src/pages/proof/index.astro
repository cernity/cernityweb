---
import Base from '../../layouts/Base.astro';
import SideBySide from '../../components/SideBySide.astro';
import figures from '../../content/proof/figures.json';
---
<Base title="Detection evidence — Cernity" description="Four curated benchmark comparisons showing how Cernity derives security findings from Suricata telemetry, with test scope and limitations.">
  <section class="hero page-hero"><span class="pill">CERNITY / DETECTION EVIDENCE</span><h1>Same traffic.<br />More to investigate.</h1><p class="lede">What Suricata records. What Cernity derives. Four comparisons from the project's synthetic replay benchmarks, with the measurements and limitations alongside the results.</p></section>
  <nav class="proof-index" aria-label="Benchmark comparisons">{figures.comparisons.map((c,i)=><a href={`#${c.id}`}>0{i+1} / {c.title}</a>)}</nav>
  <section aria-label="Comparison results">{figures.comparisons.map(c=><SideBySide c={c}/>)}</section>
  <section id="limitations"><div class="caveat"><h3>Scope and limitations</h3><ul>{figures.caveat.points.map(p=><li>{p}</li>)}</ul></div><p class="proof-method">These curated figures come from the project's privately retained evidence package. The raw captures and audits are not published here, so this page is a summary rather than a publicly reproducible validation report. Review the <a href="https://github.com/cernity/cernityndr">source and benchmark harness on GitHub ↗</a> to evaluate the implementation.</p></section>
</Base>
